{
  "name": "@intellecxplore/plugin-theme",
  "version": "1.1.3",
  "description": "IntellecXplore brand theme for DeepSeek Harness: palette, wordmark, HARNESS badge, fonts, and running copy.",
  "license": "MIT",
  "author": "IntellecXplore",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IntellecXplore/IntellX-harness-plugins.git",
    "directory": "plugins/theme"
  },
  "homepage": "https://github.com/IntellecXplore/IntellX-harness-plugins/tree/main/plugins/theme",
  "bugs": {
    "url": "https://github.com/IntellecXplore/IntellX-harness-plugins/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-theme",
    "deepseek-harness",
    "intellecxplore",
    "branding"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "icon": "./icon.png",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./assets-server": "./assets-server.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "assets-server.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/*.png",
    "assets/*.ico",
    "assets/*.webmanifest",
    "skills/**/*",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
